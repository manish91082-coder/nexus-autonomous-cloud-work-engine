{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manish91082-coder/nexus-autonomous-cloud-work-engine/blob/master/schemas/durable-execution-v1.schema.json",
  "title": "B4 durable execution event v1",
  "type": "object",
  "required": [
    "event_id",
    "scope",
    "kind",
    "at",
    "prev_hash",
    "event_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "worker": {
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "description": "Evidence metadata only; no credentials or private data."
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
