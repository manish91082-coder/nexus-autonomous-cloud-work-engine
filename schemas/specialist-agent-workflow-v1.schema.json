{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manish91082-coder/nexus-autonomous-cloud-work-engine/blob/master/schemas/specialist-agent-workflow-v1.schema.json",
  "title": "Phase 59.26 typed specialist agent research batch v1",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "source_families"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "source_families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/sourceFamily"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "claim",
        "source_type",
        "source_uri",
        "retrieved_at_utc",
        "sha256",
        "status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "OFFICIAL",
            "PRIMARY",
            "SECONDARY",
            "INTERNAL_TEST",
            "MODEL_DRAFT"
          ]
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "CONTRADICTED",
            "REJECTED"
          ]
        },
        "gate": {
          "type": "string"
        },
        "signal_type": {
          "enum": [
            "PAID_TRANSACTION",
            "PAID_COMPETITOR_USE",
            "BUYER_COMPLAINT",
            "FEATURE_REQUEST",
            "BUYER_BUDGET_SIGNAL"
          ]
        },
        "independent_party_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim",
        "evidence_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "economics": {
      "type": "object",
      "required": [
        "price_inr",
        "platform_fee_inr",
        "payment_fee_inr",
        "refund_reserve_inr",
        "delivery_cost_inr",
        "support_cost_inr",
        "other_direct_cost_inr"
      ],
      "properties": {
        "price_inr": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "platform_fee_inr": {
          "type": "number",
          "minimum": 0
        },
        "payment_fee_inr": {
          "type": "number",
          "minimum": 0
        },
        "refund_reserve_inr": {
          "type": "number",
          "minimum": 0
        },
        "delivery_cost_inr": {
          "type": "number",
          "minimum": 0
        },
        "support_cost_inr": {
          "type": "number",
          "minimum": 0
        },
        "other_direct_cost_inr": {
          "type": "number",
          "minimum": 0
        },
        "assumption_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sourceFamily": {
      "type": "object",
      "required": [
        "source_id",
        "source_family",
        "evidence",
        "economics"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "economics": {
          "$ref": "#/$defs/economics"
        }
      },
      "additionalProperties": true
    }
  }
}
