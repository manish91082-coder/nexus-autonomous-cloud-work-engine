{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manish91082-coder/nexus-autonomous-cloud-work-engine/blob/master/schemas/p10cr-worker-draft-summary-v1.schema.json",
  "title": "P10CR sanitized worker draft summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "worker_timestamp_utc",
    "source",
    "task",
    "provider",
    "usage",
    "model_output",
    "review",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "P10CR_AI_WORKER_DRAFT_SUMMARY"
    },
    "worker_timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow",
        "workflow_path",
        "event",
        "branch",
        "run_id",
        "run_attempt",
        "head_sha"
      ],
      "properties": {
        "repository": {
          "const": "manish91082-coder/nexus-autonomous-cloud-work-engine"
        },
        "workflow": {
          "const": "Mission Autonomous AI Worker (bounded, fail-closed)"
        },
        "workflow_path": {
          "const": ".github/workflows/mission-autonomous-worker.yml"
        },
        "event": {
          "enum": [
            "schedule",
            "push"
          ]
        },
        "branch": {
          "const": "master"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "const": "P59-003"
        },
        "title": {
          "const": "Audit and implement zero-cost-first autonomous multi-agent research and execution swarm"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "const": "Cloudflare Workers AI"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9@._/-]{1,256}$"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daily_calls_used",
        "daily_call_cap"
      ],
      "properties": {
        "daily_calls_used": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "daily_call_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "model_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "raw_content_included",
        "trust"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "raw_content_included": {
          "const": false
        },
        "trust": {
          "const": "UNVERIFIED_PROPOSAL"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "automatic_acceptance",
        "automatic_task_completion"
      ],
      "properties": {
        "status": {
          "const": "REQUIRES_HUMAN_EVIDENCE_REVIEW"
        },
        "automatic_acceptance": {
          "const": false
        },
        "automatic_task_completion": {
          "const": false
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_output_is_untrusted",
        "no_generated_code_execution",
        "no_publication_or_money_movement"
      ],
      "properties": {
        "model_output_is_untrusted": {
          "const": true
        },
        "no_generated_code_execution": {
          "const": true
        },
        "no_publication_or_money_movement": {
          "const": true
        }
      }
    }
  }
}
